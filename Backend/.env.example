#Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

#MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=quanlyrapchieuphim

#Gemini AI
GEMINI_API_KEY=your_gemini_api_key
# gemini-3.5-flash-lite (~1s) | gemini-3.5-flash (~10s) | gemini-3.8-flash (~120s, KHÔNG nên dùng)
GEMINI_MODEL=gemini-3.5-flash-lite
# Timeout mỗi lần gọi (ms) — tránh treo UI
GEMINI_TIMEOUT_MS=20000

#JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
